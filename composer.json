{
    "name": "monapay/laravel",
    "description": "Tích hợp MONA Pay cho Laravel 10, 11 và 12: VietQR động, webhook có chữ ký và event thanh toán.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "monapay",
        "laravel",
        "vietqr",
        "webhook",
        "bank-transfer"
    ],
    "authors": [
        {
            "name": "MONA Software",
            "email": "info@themona.global",
            "homepage": "https://mona.software"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "monapay/php-sdk": "^0.4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.22 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MonaPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonaPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MonaPay\\Laravel\\MonaPayServiceProvider"
            ],
            "aliases": {
                "MonaPay": "MonaPay\\Laravel\\Facades\\MonaPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://monapay.vn/docs",
    "support": {
        "source": "https://github.com/mona-software/laravel-monapay"
    }
}
